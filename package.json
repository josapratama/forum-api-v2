{
  "name": "forum-api",
  "version": "1.0.0",
  "description": "Forum API - Dicoding CICD and Security Project",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --coverage --runInBand --forceExit",
    "test:watch": "jest --watch",
    "migrate": "node-pg-migrate up",
    "migrate:test": "cross-env NODE_ENV=test node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "lint": "eslint src --ext .js"
  },
  "dependencies": {
    "@hapi/hapi": "^21.3.10",
    "@hapi/jwt": "^3.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "nanoid": "^3.3.7",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.3.2",
    "nodemon": "^3.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js",
      "!src/Infrastructures/database/**"
    ],
    "setupFiles": [
      "./tests/setup.js"
    ]
  }
}
