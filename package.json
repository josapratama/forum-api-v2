  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/app.js",
    "start:dev": "nodemon src/app.js",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "migrate": "node node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:prod": "cross-env NODE_ENV=production node node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:test": "cross-env NODE_ENV=test node node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:setup": "powershell -ExecutionPolicy Bypass -File setup-and-test.ps1",
    "lint": "eslint ./"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.6.1",
    "instances-container": "^2.0.6",
    "nanoid": "^5.0.9",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.38.0",
    "@eslint/js": "^9.38.0",
    "@vitest/eslint-plugin": "^1.3.26",
    "eslint-config-dicodingacademy": "^0.9.5",
    "node-pg-migrate": "^8.0.4",
    "nodemon": "^3.1.9",
    "vitest": "^4.0.17",
